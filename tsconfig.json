{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["miniprogram-api-typings", "node"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["miniprogram/**/*.ts", "server/**/*.ts", "tests/**/*.ts"]
}


