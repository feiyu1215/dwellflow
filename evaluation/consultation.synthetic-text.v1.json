        "sources": [
          { "id": "record_tile_sound", "kind": "record", "title": "现场敲击记录", "text": "2026-09-26，家人记录卫生间东墙中部部分墙砖敲击声与周边不同，尚未网格定位。", "version": "1", "authority": "project_fact" },
          { "id": "issue_tile_consult", "kind": "issue", "title": "墙砖异常待确认", "text": "{\"issue\":{\"title\":\"卫生间东墙敲击声待确认\",\"description\":\"范围、原因和处理必要性未知\",\"status\":\"pending_confirmation\"},\"workflow\":{\"version\":1}}", "version": "2026-09-27T05:00:00.000Z:1", "authority": "project_fact" }
