        "images": []
      },
      "expected": {
        "mode": "prepare",
        "minFacts": 1,
        "minItems": 1,
        "itemTextIncludesAny": ["范围", "复核", "证据", "确认"],
        "sourceIdsInclude": ["issue_tile_consult"],
        "forbiddenPhrases": ["确认空鼓", "必须返工", "已经发送"]
      }
