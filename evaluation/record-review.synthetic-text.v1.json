      "input": {
        "projectId": "eval_project",
        "stage": "水电",
        "question": "把两条记录整理成可编辑草稿，房间不要混淆。",
        "sources": [
          { "id": "record_kitchen", "kind": "record", "title": "厨房记录", "text": "2026-09-20 我记录：厨房水槽左侧插座位置向右调整约十厘米，照片里没有尺子。", "version": "1", "authority": "project_fact" },
          { "id": "record_bathroom", "kind": "record", "title": "卫生间记录", "text": "2026-09-20 家人记录：卫生间镜柜电源线已经从墙面预留口引出。", "version": "1", "authority": "project_fact" }
        ],
        "images": []
      },
      "expected": {
        "minFacts": 2,
        "facts": [
          { "sourceIdsInclude": ["record_kitchen"], "textIncludesAny": ["插座", "位置"], "roomIncludesAny": ["厨房"] },
          { "sourceIdsInclude": ["record_bathroom"], "textIncludesAny": ["电源线", "预留"], "roomIncludesAny": ["卫生间"] }
        ],
        "time": { "candidateDateEquals": "2026-09-20" }
      }
    },
    {
