/* R8-UI-1E: draggable edge handle and in-place rotary half dial. */
.assist-area { position: fixed; top: 110rpx; right: 0; z-index: 18; width: 76rpx; height: calc(100vh - 220rpx); pointer-events: none; }
.assist-movable { width: 76rpx; height: 96rpx; pointer-events: auto; }
.assist-handle { position: absolute; top: 11rpx; right: 0; display: flex; width: 54rpx; height: 74rpx; flex-direction: column; align-items: center; justify-content: center; gap: 7rpx; border: 1rpx solid #d6dbd7; border-right: 0; border-radius: 22rpx 0 0 22rpx; background: rgba(255,255,255,.96); box-shadow: 0 8rpx 25rpx rgba(24,31,27,.13); transition: width .18s ease,background .18s ease; }
.assist-handle.is-open { width: 64rpx; background: #f2f5f2; }.handle-line { width: 21rpx; height: 2rpx; border-radius: 2rpx; background: #34403a; }.handle-line.one { transform: translateX(3rpx); }.handle-line.three { transform: translateX(-3rpx); }
.dial-scrim { position: fixed; inset: 0; z-index: 19; background: rgba(23,29,26,.24); animation: dial-fade .18s ease-out; }
.edge-dial { position: fixed; right: 0; z-index: 20; width: 390rpx; height: 610rpx; overflow: hidden; border: 1rpx solid #d9deda; border-right: 0; border-radius: 310rpx 0 0 310rpx; background: rgba(250,251,249,.985); box-shadow: -18rpx 18rpx 58rpx rgba(20,27,23,.18); animation: dial-enter .22s ease-out; }
.dial-ring { position: absolute; border: 1rpx solid #d9deda; border-radius: 50%; pointer-events: none; }.ring-one { top: 67rpx; right: -238rpx; width: 474rpx; height: 474rpx; }.ring-two { top: 126rpx; right: -179rpx; width: 356rpx; height: 356rpx; border-color: #e6e9e6; }
.dial-ticks { position: absolute; top: 41rpx; right: -265rpx; width: 526rpx; height: 526rpx; border: 2rpx dotted #aeb6b0; border-radius: 50%; opacity: .68; pointer-events: none; }.dial-spine { position: absolute; top: 301rpx; left: 143rpx; width: 247rpx; height: 1rpx; background: linear-gradient(90deg,#aeb6b0,transparent); pointer-events: none; }
.dial-node { position: absolute; display: flex; width: 188rpx; min-height: 58rpx; align-items: center; gap: 12rpx; transform-origin: center; transition: top .18s ease,left .18s ease,opacity .18s ease,transform .18s ease; }
.dial-node.selected .dial-node-label { color: #0a73dc; }.dial-node.selected .dial-icon { color: #0a73dc; border-color: #0a73dc; }.dial-node-copy { min-width: 0; }.dial-node-label { overflow: hidden; color: #28302b; font-size: 21rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.dial-node-hint { overflow: hidden; margin-top: 3rpx; color: #7d847f; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }
.dial-icon { position: relative; box-sizing: border-box; width: 43rpx; height: 43rpx; flex: 0 0 auto; color: #667069; border: 2rpx solid currentColor; border-radius: 10rpx; }.dial-icon view { position: absolute; box-sizing: border-box; }
.icon-overview view { width: 7rpx; height: 7rpx; border-radius: 2rpx; background: currentColor; }.icon-overview view:nth-child(1) { top: 9rpx; left: 9rpx; }.icon-overview view:nth-child(2) { top: 9rpx; right: 9rpx; }.icon-overview view:nth-child(3) { bottom: 9rpx; left: 9rpx; }.icon-overview view:nth-child(4) { right: 9rpx; bottom: 9rpx; }
.icon-patrol { border-radius: 50%; }.icon-patrol::before { position: absolute; top: 8rpx; left: 17rpx; width: 5rpx; height: 22rpx; border-radius: 5rpx; background: currentColor; content: ""; transform: rotate(35deg); }.icon-patrol::after { position: absolute; top: 7rpx; left: 12rpx; border-right: 7rpx solid transparent; border-bottom: 11rpx solid currentColor; border-left: 7rpx solid transparent; content: ""; transform: rotate(35deg); }
.icon-evidence::before { position: absolute; right: 6rpx; bottom: 7rpx; left: 6rpx; height: 14rpx; border-bottom: 2rpx solid currentColor; content: ""; transform: skewY(-22deg); }.icon-evidence::after { position: absolute; top: 8rpx; right: 9rpx; width: 7rpx; height: 7rpx; border: 2rpx solid currentColor; border-radius: 50%; content: ""; }
.icon-record::before { position: absolute; top: 9rpx; right: 8rpx; bottom: 9rpx; left: 8rpx; border-top: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; }.icon-record::after { position: absolute; top: 19rpx; right: 8rpx; left: 8rpx; height: 2rpx; background: currentColor; content: ""; }
.icon-issue { border-radius: 50%; }.icon-issue::before { position: absolute; top: 8rpx; left: 18rpx; width: 3rpx; height: 16rpx; border-radius: 3rpx; background: currentColor; content: ""; }.icon-issue::after { position: absolute; bottom: 8rpx; left: 18rpx; width: 4rpx; height: 4rpx; border-radius: 50%; background: currentColor; content: ""; }
.icon-material::before { position: absolute; top: 10rpx; right: 7rpx; left: 7rpx; height: 6rpx; border-top: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; }.icon-material::after { position: absolute; right: 7rpx; bottom: 9rpx; left: 7rpx; height: 6rpx; border-top: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; }
.icon-ai { border-radius: 50% 50% 50% 12rpx; }.icon-ai::before { position: absolute; top: 12rpx; left: 10rpx; width: 18rpx; height: 10rpx; border-top: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; }.icon-ai::after { position: absolute; right: 9rpx; bottom: 8rpx; width: 7rpx; height: 7rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ""; }
.icon-more { border: 0; }.icon-more::before { position: absolute; top: 18rpx; left: 4rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: currentColor; box-shadow: 14rpx 0 currentColor,28rpx 0 currentColor; content: ""; }
.dial-context { position: absolute; top: 218rpx; right: 18rpx; width: 180rpx; min-height: 165rpx; text-align: right; }.dial-kicker { overflow: hidden; color: #7a817c; font-size: 16rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }.dial-selection { margin-top: 12rpx; color: #202521; font-size: 28rpx; font-weight: 760; line-height: 1.2; }.dial-selection-hint { margin-top: 7rpx; color: #707772; font-size: 17rpx; line-height: 1.4; }.dial-enter { margin-top: 15rpx; color: #0a73dc; font-size: 18rpx; font-weight: 700; }
.dial-more-list { position: absolute; top: 126rpx; right: 14rpx; width: 226rpx; padding: 13rpx 0; }.more-head,.more-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.more-head { margin-bottom: 8rpx; color: #777e79; font-size: 17rpx; }.more-head text:first-child { color: #242925; font-size: 22rpx; font-weight: 750; }.more-head text:last-child { color: #0a73dc; }.more-row { min-height: 65rpx; border-top: 1rpx solid #e0e4e1; color: #313833; font-size: 19rpx; }
.dial-guide { position: absolute; right: 18rpx; bottom: 35rpx; color: #909792; font-size: 15rpx; }.dial-close { position: absolute; top: 24rpx; right: 19rpx; width: 43rpx; height: 43rpx; border-radius: 50%; color: #58615b; background: #e9ece9; font-size: 29rpx; line-height: 40rpx; text-align: center; }
@keyframes dial-fade { from { opacity: 0; } } @keyframes dial-enter { from { opacity: 0; transform: translateX(50rpx); } }
@media (max-width: 360px) { .edge-dial { width: 370rpx; }.dial-context { right: 13rpx; width: 165rpx; }.dial-more-list { right: 10rpx; width: 215rpx; } }
