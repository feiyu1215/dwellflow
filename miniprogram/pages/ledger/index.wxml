<view class="page">
  <view class="utility-header">
    <view class="eyebrow">计划、批准与实际发生分开记录</view>
    <view class="title">材料与费用</view>
    <view class="subtitle">{{hasProject ? projectName + ' · 报价、批准、付款和退款分别留痕。' : '先创建项目，再记录材料、预算和真实支出。'}}</view>
  </view>
  <view wx:if="{{hasProject && readOnly}}" class="readonly-banner">项目已归档：预算、材料、批准、付款和退款均为只读。</view>

  <view wx:if="{{!hasProject}}" class="no-project card">
    <view class="empty-title">还没有可管理的项目</view>
    <view class="meta">创建项目后再建立材料和费用，避免不同装修的账目混在一起。</view>
    <button class="primary no-project-button" bindtap="manageProject">创建项目</button>
  </view>

  <view wx:if="{{hasProject}}" class="summary-grid">
    <view class="summary-card {{readOnly ? '' : 'summary-action interactive-card'}}" bindtap="openBudget"><view class="meta">目标预算</view><view class="summary-number">{{summary.target}}</view><view wx:if="{{!readOnly}}" class="summary-edit">设置 / 调整</view></view>
    <view class="summary-card"><view class="meta">报价合计</view><view class="summary-number">{{summary.quoted}}</view></view>
    <view class="summary-card"><view class="meta">负责人已批准</view><view class="summary-number">{{summary.approved}}</view></view>
    <view class="summary-card"><view class="meta">确认净付款</view><view class="summary-number">{{summary.netPaid}}</view></view>
    <view class="summary-card summary-wide"><view class="meta">待确认付款 / 退款</view><view class="summary-number pending-number">{{summary.pending}}</view></view>
  </view>

  <view wx:if="{{hasProject}}" class="tabs">
    <view class="tab {{activeTab === 'materials' ? 'tab-active' : ''}}" data-tab="materials" bindtap="setTab">材料库存</view>
    <view class="tab {{activeTab === 'expenses' ? 'tab-active' : ''}}" data-tab="expenses" bindtap="setTab">费用账本</view>
  </view>

  <block wx:if="{{hasProject && activeTab === 'materials'}}">
    <button wx:if="{{!readOnly}}" class="primary wide-button" bindtap="openMaterial">＋ 新增材料</button>
    <view wx:if="{{budgetEstimates.length}}" class="estimate-history">
      <view class="row estimate-heading">
        <view class="section-title">负责人采纳的 AI 估算</view>
        <view class="meta">{{budgetEstimateTotal}} 个版本</view>
      </view>
      <view class="estimate-disclaimer">估算版本只记录参数、资源缺口与费用快照，不会自动创建采购、批准费用或付款。</view>
      <view class="card estimate-version" wx:for="{{budgetEstimates}}" wx:for-item="estimate" wx:key="id">
        <view class="row"><view class="item-title">{{estimate.timeLabel}}</view><view class="pill pill-green">已采纳</view></view>
        <view class="meta estimate-author">{{estimate.appliedBy}} · {{estimate.financeLabel}}</view>
        <view class="estimate-summary">{{estimate.summary}}</view>
        <view class="estimate-scenario" wx:for="{{estimate.scenarios}}" wx:for-item="scenario" wx:key="scenarioId">
          <view class="fact-title">{{scenario.label}}</view>
          <view class="meta scenario-line">{{scenario.totalLabel}}</view>
          <view class="meta scenario-line">{{scenario.gapLabel}}</view>
          <view class="scenario-purchase">{{scenario.purchaseLabel}}</view>
          <view wx:if="{{scenario.warningLabel}}" class="scenario-warning">{{scenario.warningLabel}}</view>
          <view wx:if="{{scenario.note}}" class="meta scenario-line">复核备注：{{scenario.note}}</view>
        </view>
      </view>
      <view wx:if="{{budgetEstimateTotal > budgetEstimates.length}}" class="meta estimate-limit">这里只展示最近 10 个版本，完整来源与复核记录仍保留在 AI 任务历史中。</view>
    </view>
    <view wx:if="{{materials.length}}">
      <view class="card material-card interactive-card" wx:for="{{materials}}" wx:key="id" data-id="{{item.id}}" bindtap="openMaterialDetail">
        <view class="row"><view class="item-title">{{item.name}}</view><view class="{{item.statusClass}}">{{item.statusLabel}}</view></view>
        <view class="meta material-detail">{{item.detail}}</view>
        <view class="row material-balance"><view class="meta">可用库存</view><view class="balance">{{item.balance}}</view></view>
        <view class="meta material-flow">{{item.flow}}</view>
        <view class="estimate">{{item.estimate}}</view>
        <view class="detail-link">查看约定、采购与到货 →</view>
      </view>
    </view>
    <view wx:else class="empty card">先建立材料，再从详情依次记录约定、采购、到货核对、入库和领用。</view>
  </block>

  <block wx:elif="{{hasProject}}">
    <button wx:if="{{!readOnly}}" class="primary wide-button" bindtap="openCost">＋ 新增费用事项</button>
    <view wx:if="{{costItems.length}}">
      <view class="card cost-card interactive-card" wx:for="{{costItems}}" wx:key="id" data-id="{{item.id}}" bindtap="openCostDetail">
        <view class="row"><view class="item-title">{{item.title}}</view><view class="{{item.statusClass}}">{{item.statusLabel}}</view></view>
        <view class="meta material-detail">{{item.categoryLabel}}<text wx:if="{{item.materialLabel}}"> · {{item.materialLabel}}</text><text wx:if="{{item.note}}"> · {{item.note}}</text></view>
        <view class="cost-grid">
          <view><view class="meta">报价</view><view class="cost-number">{{item.quote}}</view></view>
          <view><view class="meta">已批准</view><view class="cost-number">{{item.approved}}</view></view>
          <view><view class="meta">净付款</view><view class="cost-number">{{item.netPaid}}</view></view>
        </view>
        <view class="detail-link">查看批准、付款与退款 →</view>
      </view>
    </view>
    <view wx:else class="empty card">先建立一项报价或费用，再由负责人批准；付款和退款分别登记、分别确认。</view>
  </block>

  <view wx:if="{{selectedCost && !showForm}}" class="sheet-mask" bindtap="closeCostDetail">
    <view class="sheet detail-sheet" catchtap="noop">
      <view class="sheet-toolbar"><view class="sheet-handle"></view><view class="sheet-close" bindtap="closeCostDetail">关闭</view></view>
      <view class="row detail-heading">
        <view><view class="section-title cost-title">{{selectedCost.title}}</view><view class="meta">{{selectedCost.categoryLabel}}<text wx:if="{{selectedCost.materialLabel}}"> · {{selectedCost.materialLabel}}</text></view></view>
        <view class="{{selectedCost.statusClass}}">{{selectedCost.statusLabel}}</view>
      </view>
      <view wx:if="{{selectedCost.note}}" class="cost-note">{{selectedCost.note}}</view>
      <view class="detail-summary">
        <view><view class="meta">报价</view><view>{{selectedCost.quote}}</view></view>
        <view><view class="meta">已批准</view><view>{{selectedCost.approved}}</view></view>
        <view><view class="meta">已付款</view><view>{{selectedCost.paid}}</view></view>
        <view><view class="meta">已退款</view><view>{{selectedCost.refunded}}</view></view>
        <view><view class="meta">净付款</view><view>{{selectedCost.netPaid}}</view></view>
        <view><view class="meta">待付</view><view>{{selectedCost.outstanding}}</view></view>
      </view>
      <view wx:if="{{selectedCost.pendingCount}}" class="pending-banner">还有 {{selectedCost.pendingCount}} 笔付款或退款等待负责人确认，金额 {{selectedCost.pending}}。</view>
      <view wx:if="{{!readOnly}}" class="detail-actions">
        <button class="secondary action-button" bindtap="openApproval">{{selectedCost.approvalCount ? '调整批准金额' : '负责人批准'}}</button>
        <button class="primary action-button" bindtap="openPayment">登记付款</button>
      </view>

      <view class="divider"></view>
      <view class="section-title">批准记录</view>
      <view wx:if="{{selectedCost.approvals.length}}">
        <view class="fact-row" wx:for="{{selectedCost.approvals}}" wx:key="id">
          <view><view class="fact-title">{{item.actionLabel}}</view><view class="meta">{{item.timeLabel}}<text wx:if="{{item.reason}}"> · {{item.reason}}</text></view></view>
          <view class="fact-amount">{{item.amountLabel}}</view>
        </view>
      </view>
      <view wx:else class="inline-empty">还没有负责人批准记录。</view>

      <view class="divider"></view>
      <view class="section-title">付款记录</view>
      <view wx:if="{{selectedCost.payments.length}}">
        <view class="fact-card" wx:for="{{selectedCost.payments}}" wx:key="id">
          <view class="row"><view class="fact-title">付款 {{item.amountLabel}}</view><view class="{{item.statusClass}}">{{item.statusLabel}}</view></view>
          <view class="meta fact-meta">发生于 {{item.timeLabel}}</view>
          <view wx:if="{{item.canDecide && !readOnly}}" class="decision-buttons">
            <button class="secondary compact-button" data-id="{{item.id}}" data-decision="rejected" bindtap="decidePayment">驳回</button>
            <button class="primary compact-button" data-id="{{item.id}}" data-decision="confirmed" bindtap="decidePayment">负责人确认</button>
          </view>
          <button wx:if="{{item.canRefund && !readOnly}}" class="secondary refund-button" data-id="{{item.id}}" data-label="{{item.refundableLabel}}" bindtap="openRefund">登记退款 · 最多 {{item.refundableLabel}}</button>
        </view>
      </view>
      <view wx:else class="inline-empty">还没有付款记录。</view>

      <view wx:if="{{selectedCost.refunds.length}}">
        <view class="divider"></view>
        <view class="section-title">退款记录</view>
        <view class="fact-card refund-card" wx:for="{{selectedCost.refunds}}" wx:key="id">
          <view class="row"><view class="fact-title">退款 {{item.amountLabel}}</view><view class="{{item.statusClass}}">{{item.statusLabel}}</view></view>
          <view class="meta fact-meta">发生于 {{item.timeLabel}}</view>
          <view wx:if="{{item.canDecide && !readOnly}}" class="decision-buttons">
            <button class="secondary compact-button" data-id="{{item.id}}" data-decision="rejected" bindtap="decideRefund">驳回</button>
            <button class="primary compact-button" data-id="{{item.id}}" data-decision="confirmed" bindtap="decideRefund">负责人确认</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasProject && showForm && !readOnly}}" class="sheet-mask action-mask" bindtap="closeForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-toolbar"><view class="sheet-handle"></view><view class="sheet-close" bindtap="closeForm">关闭</view></view>

      <block wx:if="{{showForm === 'budget'}}">
        <view class="section-title">设置目标预算</view>
        <view class="label">金额（元）</view>
        <input class="input" type="digit" value="{{targetBudget}}" bindinput="onTargetBudget" placeholder="例如：180000.00" />
        <view class="form-tip">目标预算表达家庭计划上限，不会被报价、批准或付款自动覆盖。</view>
        <button class="primary" bindtap="submitBudget">保存目标预算</button>
      </block>

      <block wx:elif="{{showForm === 'material'}}">
        <view class="section-title">新增材料</view>
        <view class="label">材料名称</view>
        <input class="input" value="{{materialName}}" bindinput="onMaterialName" placeholder="例如：卫生间墙砖" />
        <view class="label">品牌 / 型号 / 规格</view>
        <input class="input" value="{{specification}}" bindinput="onSpecification" placeholder="例如：600×1200 mm，浅灰" />
        <view class="form-grid">
          <view><view class="label">单位</view><input class="input" value="{{unit}}" bindinput="onUnit" /></view>
          <view><view class="label">计划数量</view><input class="input" type="digit" value="{{plannedQuantity}}" bindinput="onPlannedQuantity" /></view>
        </view>
        <view class="form-grid">
          <view><view class="label">估算单价（元，可空）</view><input class="input" type="digit" value="{{unitPrice}}" bindinput="onUnitPrice" /></view>
          <view><view class="label">损耗假设（%）</view><input class="input" type="digit" value="{{wasteRate}}" bindinput="onWasteRate" /></view>
        </view>
        <button class="primary" bindtap="submitMaterial">保存材料</button>
      </block>

      <block wx:elif="{{showForm === 'cost'}}">
        <view class="section-title">新增费用事项</view>
        <view class="label">事项名称</view>
        <input class="input" value="{{costTitle}}" bindinput="onCostTitle" placeholder="例如：全屋水电施工" />
        <view class="label">类别</view>
        <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategory">
          <view class="picker">{{categories[categoryIndex].label}}</view>
        </picker>
        <view class="label">当前报价（元，可空）</view>
        <input class="input" type="digit" value="{{costQuote}}" bindinput="onCostQuote" placeholder="例如：12800.00" />
        <view class="label">关联材料（可空）</view>
        <picker mode="selector" range="{{costMaterialOptions}}" range-key="name" value="{{costMaterialIndex}}" bindchange="onCostMaterial">
          <view class="picker">{{costMaterialOptions[costMaterialIndex].name || '不关联材料'}}</view>
        </picker>
        <view class="label">报价范围或说明</view>
        <textarea class="textarea" value="{{costNote}}" bindinput="onCostNote" placeholder="记录包含内容、来源或尚未确定的部分" />
        <view class="form-tip">报价只是参考值。创建后仍需负责人单独批准，再登记实际付款。</view>
        <button class="primary" bindtap="submitCost">创建费用事项</button>
      </block>

      <block wx:elif="{{showForm === 'approval'}}">
        <view class="section-title">负责人批准</view>
        <view class="label">动作</view>
        <picker mode="selector" range="{{approvalActions}}" range-key="label" value="{{approvalActionIndex}}" bindchange="onApprovalAction">
          <view class="picker">{{approvalActions[approvalActionIndex].label}}</view>
        </picker>
        <view class="label">金额（元）</view>
        <input class="input" type="digit" value="{{approvalAmount}}" bindinput="onApprovalAmount" placeholder="必须大于 0" />
        <view class="label">依据或调整原因</view>
        <textarea class="textarea" value="{{approvalReason}}" bindinput="onApprovalReason" placeholder="增减金额时必须填写原因" />
        <button class="primary" bindtap="submitApproval">保存批准记录</button>
      </block>

      <block wx:elif="{{showForm === 'payment'}}">
        <view class="section-title">登记付款</view>
        <view class="form-tip">这里记录已发生或声称已发生的付款。登记后先进入待确认，不会立刻计入净付款。</view>
        <view class="label">付款金额（元）</view>
        <input class="input" type="digit" value="{{paymentAmount}}" bindinput="onPaymentAmount" placeholder="例如：5000.00" />
        <button class="primary" bindtap="submitPayment">提交负责人确认</button>
      </block>

      <block wx:elif="{{showForm === 'refund'}}">
        <view class="section-title">登记退款</view>
        <view class="form-tip">退款必须绑定这笔已确认付款；当前最多可登记 {{refundPaymentLabel}}。</view>
        <view class="label">退款金额（元）</view>
        <input class="input" type="digit" value="{{refundAmount}}" bindinput="onRefundAmount" placeholder="必须大于 0" />
        <button class="primary" bindtap="submitRefund">提交负责人确认</button>
      </block>

      <button class="text-button" bindtap="closeForm">取消</button>
    </view>
  </view>
</view>
