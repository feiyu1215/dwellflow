.quick-record-page { height: 100vh; overflow: hidden; color: #171918; background: #f7f8f9; }
.quick-nav { box-sizing: border-box; min-height: 184rpx; display: grid; grid-template-columns: 120rpx minmax(0,1fr) 120rpx; align-items: end; padding: max(96rpx, env(safe-area-inset-top)) 28rpx 22rpx; border-bottom: 1rpx solid #eceef0; background: #fff; font-size: 24rpx; font-weight: 720; text-align: center; }
.quick-back { color: #0878ed; font-size: 20rpx; font-weight: 520; text-align: left; }
.quick-state { visibility: hidden; }
.quick-scroll { height: calc(100vh - 184rpx); }
.quick-body { box-sizing: border-box; min-height: 100%; padding: 38rpx 30rpx calc(54rpx + env(safe-area-inset-bottom)); }
.quick-kicker { color: #0878ed; font-size: 18rpx; font-weight: 760; letter-spacing: 1rpx; }
.quick-title { margin-top: 11rpx; color: #171918; font-size: 45rpx; font-weight: 790; line-height: 1.18; letter-spacing: -1rpx; }
.quick-copy { margin-top: 10rpx; color: #737980; font-size: 20rpx; line-height: 1.6; }
.quick-context { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 24rpx; }
.quick-context text { padding: 10rpx 15rpx; border-radius: 999rpx; color: #596068; background: #eceff2; font-size: 17rpx; }
.quick-origin { display: inline-flex; max-width: 100%; align-items: center; gap: 9rpx; margin-top: 14rpx; color: #1767c5; font-size: 17rpx; }
.quick-origin view { flex: none; width: 8rpx; height: 8rpx; border-radius: 50%; background: #1476ec; }
.quick-origin text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.quick-card { box-sizing: border-box; margin-top: 28rpx; padding: 24rpx; border: 1rpx solid #dce1e5; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 34rpx rgba(30,40,48,.05); }
.quick-label { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; color: #1f2326; font-size: 19rpx; font-weight: 690; }
.quick-label text:last-child { color: #858b91; font-size: 16rpx; font-weight: 450; }
.quick-source { box-sizing: border-box; width: 100%; min-height: 260rpx; margin-top: 15rpx; padding: 0; color: #202428; font-size: 25rpx; line-height: 1.65; }
.quick-boundary, .quick-notice { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 18rpx; color: #676e75; background: #eef1f3; font-size: 17rpx; line-height: 1.6; }
.quick-notice { color: #87540d; background: #fff4df; }
.quick-primary { margin-top: 28rpx; }
.quick-secondary { margin-top: 13rpx; }
.quick-source-quote { margin-top: 27rpx; padding: 20rpx; border-radius: 19rpx; color: #545b62; background: #eef1f3; font-size: 18rpx; line-height: 1.6; }
.quick-source-quote text { display: block; margin-bottom: 6rpx; color: #757c83; font-size: 16rpx; }
.review-card { padding-top: 9rpx; padding-bottom: 9rpx; }
.quick-field { padding: 20rpx 0; border-bottom: 1rpx solid #edf0f2; }
.quick-field:last-child { border-bottom: 0; }
.quick-input, .quick-note { box-sizing: border-box; width: 100%; margin-top: 9rpx; padding: 0; color: #171918; font-size: 23rpx; line-height: 1.55; }
.quick-input { height: 58rpx; line-height: 58rpx; }
.quick-note { min-height: 98rpx; }
.quick-picker { min-height: 58rpx; margin-top: 7rpx; color: #171918; font-size: 22rpx; line-height: 58rpx; }
.quick-empty { box-sizing: border-box; min-height: calc(100vh - 184rpx); display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 38rpx; text-align: center; }
.quick-empty .empty-mark { display: grid; width: 80rpx; height: 80rpx; place-items: center; margin-bottom: 24rpx; border: 1rpx solid #d9dfe3; border-radius: 50%; color: #0878ed; background: #fff; font-size: 34rpx; }
.quick-empty .primary, .quick-empty .secondary { width: 100%; margin-top: 28rpx; }
@media (max-width: 360px) {
  .quick-nav { grid-template-columns: 105rpx minmax(0,1fr) 105rpx; padding-right: 22rpx; padding-left: 22rpx; }
  .quick-body { padding-right: 24rpx; padding-left: 24rpx; }
  .quick-title { font-size: 40rpx; }
  .quick-card { padding-right: 20rpx; padding-left: 20rpx; }
}

