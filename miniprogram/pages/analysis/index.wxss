.mode-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10rpx; }
.mode-button { margin: 0; padding: 0 12rpx; font-size: 24rpx; line-height: 72rpx; }
.mode-note { line-height: 1.6; margin: 16rpx 4rpx 34rpx; }
.history-title { margin-top: 28rpx; }
.source { color: var(--green); font-weight: 720; }
.item-meta { margin-top: 10rpx; }
.analysis-group { margin-top: 24rpx; }
.analysis-heading { font-weight: 720; margin-bottom: 10rpx; }
.analysis-line { line-height: 1.65; margin-bottom: 6rpx; }
.unknown-box { background: var(--warning-soft); border-radius: 16rpx; padding: 18rpx; color: var(--warning); }
.decision-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 24rpx; }
.small-button { margin: 0; font-size: 24rpx; line-height: 68rpx; padding: 0 16rpx; }
.reference-box { background: var(--green-soft); border-radius: 16rpx; padding: 18rpx; margin-bottom: 24rpx; }
.reference-title { color: var(--green); margin-top: 8rpx; }
.short-textarea { min-height: 130rpx; }
