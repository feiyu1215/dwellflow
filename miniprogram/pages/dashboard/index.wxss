.illustrated-thumb text {
  position: absolute;
  right: 7rpx;
  bottom: 7rpx;
  padding: 3rpx 7rpx;
  border-radius: 999rpx;
  color: #4f5853;
  background: rgba(255,255,255,.9);
  font-size: 13rpx;
  font-weight: 650;
}
.patrol-view-bar {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  background: #fff;
}
.view-bar-copy { flex: none; }
.view-bar-copy text { display: block; color: var(--faint); font-size: 15rpx; }
.view-bar-copy view { margin-top: 1rpx; color: var(--ink); font-size: 20rpx; font-weight: 680; }
.patrol-view-switch {
  display: grid;
  min-width: 380rpx;
  grid-template-columns: 1fr 1fr;
  padding: 5rpx;
  border-radius: 999rpx;
  background: #eef0ee;
}
.patrol-view-switch view {
  display: grid;
  min-height: 56rpx;
  place-items: center;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: var(--muted);
  font-size: 18rpx;
  white-space: nowrap;
}
.patrol-view-switch view.active { color: #075acb; background: #fff; box-shadow: 0 3rpx 14rpx rgba(41,54,47,.08); font-weight: 700; }
.patrol-view-switch view.disabled { color: #abb0ad; }
.work-step-context { min-width: 210rpx; text-align: right; }
.work-step-context text { display: block; color: var(--faint); font-size: 15rpx; }
.work-step-context view { margin-top: 1rpx; color: #075acb; font-size: 20rpx; font-weight: 700; }
.patrol-page .patrol-canvas { height: calc(100vh - 588rpx); min-height: 650rpx; }
.patrol-canvas.illustration-mode::after { background: linear-gradient(180deg,rgba(247,246,242,.08),transparent 52%,rgba(31,38,34,.12)); }
.patrol-illustration { position: absolute; z-index: 1; inset: 0; overflow: hidden; background: #f7f6f2; }
.space-illustration-image { width: 100%; height: 100%; }
.illustration-disclosure {
  position: absolute;
  z-index: 7;
  top: 72rpx;
  right: 22rpx;
  padding: 12rpx 15rpx;
  border: 1rpx solid rgba(117,127,121,.25);
  border-radius: 18rpx;
  background: rgba(255,255,255,.9);
  box-shadow: 0 8rpx 30rpx rgba(43,56,49,.08);
  text-align: right;
}
.illustration-disclosure text { display: block; color: #1d1f1e; font-size: 18rpx; font-weight: 720; }
.illustration-disclosure view { margin-top: 2rpx; color: #747c77; font-size: 14rpx; }
.illustration-marker {
  position: absolute;
  z-index: 8;
  display: grid;
  box-sizing: border-box;
  min-width: 92rpx;
  min-height: 92rpx;
  place-items: center;
  padding: 10rpx;
  border: 4rpx solid #fff;
  border-radius: 50%;
  box-shadow: 0 13rpx 38rpx rgba(44,52,48,.18);
  text-align: center;
}
.illustration-marker text { display: block; font-size: 25rpx; font-weight: 760; line-height: 1; }
.illustration-marker view { margin-top: 4rpx; font-size: 13rpx; white-space: nowrap; }
.issue-marker { top: 38%; right: 18%; color: #fff; background: #aa6b0a; }
.evidence-marker { top: 55%; left: 24%; color: #075acb; border-color: #0a6cff; background: #fff; }
.work-rail {
  position: absolute;
  z-index: 10;
  top: 100rpx;
  left: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.work-stop {
  display: grid;
  box-sizing: border-box;
  width: 92rpx;
  min-height: 84rpx;
  place-items: center;
  padding: 0 8rpx;
  border: 1rpx solid rgba(255,255,255,.72);
  border-radius: 22rpx;
  color: #fff;
  background: rgba(15,19,17,.44);
  box-shadow: 0 8rpx 24rpx rgba(22,29,25,.08);
  font-size: 18rpx;
  font-weight: 680;
}
.work-stop.selected { color: #075acb; border-color: #0a6cff; background: #fff; box-shadow: 0 12rpx 30rpx rgba(13,92,202,.15); }
.illustration-mode .work-stop { color: #525b56; border-color: rgba(126,136,130,.3); background: rgba(255,255,255,.88); }
.illustration-mode .work-stop.selected { color: #075acb; border-color: #0a6cff; background: #fff; }
.patrol-work-panel {
  position: absolute;
  z-index: 9;
  right: 24rpx;
  bottom: 26rpx;
  left: 128rpx;
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid rgba(190,197,192,.66);
  border-radius: 28rpx;
  background: rgba(255,255,255,.94);
  box-shadow: 0 18rpx 48rpx rgba(35,46,40,.14);
}
.work-panel-meta { color: #737a75; font-size: 17rpx; }
.work-panel-title { margin-top: 7rpx; color: #1d1f1e; font-size: 29rpx; font-weight: 740; line-height: 1.25; }
.work-panel-copy { margin-top: 8rpx; color: #666e69; font-size: 18rpx; line-height: 1.55; }
.work-panel-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 18rpx; }
.work-panel-actions button { width: 100%; min-height: 88rpx; margin: 0; padding: 0 12rpx; border-radius: 22rpx; font-size: 18rpx; line-height: 1.25; }
.work-panel-actions button::after { display: none; }
.work-manual { color: #fff; background: #0876e8; }
.work-ai { color: #075acb; border: 1rpx solid #b8d3fa; background: #edf5ff; }
.work-ai[disabled] { color: #9ba4a0; border-color: #d8ddda; background: #f1f3f2; }
.illustration-caption {
  position: absolute;
  z-index: 7;
  right: 26rpx;
  bottom: 26rpx;
  left: 26rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(190,197,192,.62);
  border-radius: 26rpx;
  background: rgba(255,255,255,.92);
  box-shadow: 0 16rpx 42rpx rgba(43,56,49,.11);
}
.illustration-caption .caption-meta { color: #6e756f; }
.illustration-caption .caption-title { color: #1d1f1e; font-size: 31rpx; }
.illustration-caption .caption-copy { color: #6e756f; }
.illustration-mode .canvas-coordinate { color: #4f5752; border-color: rgba(125,135,129,.25); background: rgba(255,255,255,.9); }
.illustration-mode .stage-stop { color: #525b56; border-color: rgba(126,136,130,.3); background: rgba(255,255,255,.86); }
.illustration-mode .stage-stop.selected { color: #075acb; border-color: #0a6cff; background: #fff; }
.patrol-footer.single { grid-template-columns: 1fr; }

@media (max-width: 360px) {
  .patrol-view-switch { min-width: 330rpx; }
  .view-bar-copy { display: none; }
  .patrol-view-bar { justify-content: flex-end; }
  .patrol-page .patrol-canvas { min-height: 600rpx; }
  .work-rail { top: 28rpx; gap: 4rpx; }
  .work-stop { width: 104rpx; min-height: 104rpx; }
  .patrol-work-panel { left: 136rpx; padding: 20rpx; }
  .work-panel-title { font-size: 26rpx; }
  .work-panel-actions button { min-height: 104rpx; }
}
