.observe-head { margin-top: 40rpx!important; }.view-switcher { width: auto; white-space: nowrap; }.view-switcher-inner { display: inline-flex; gap: 12rpx; padding-right: 28rpx; }.view-chip { padding: 13rpx 22rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: var(--muted); background: #fff; font-size: 23rpx; }.view-chip.active { border-color: var(--green); color: #fff; background: var(--green); }
