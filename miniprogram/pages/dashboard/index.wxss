  .r7-room-signal { top: 22rpx; left: 26rpx; }
  .r7-room-name { font-size: 23rpx; }
  .r7-room-meta { font-size: 16rpx; }
}

/* R8-UI-4C: room-specific architectural illustration, kept separate from evidence. */
