.space-grid,.stat-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; }.space-card,.stat-card { min-width: 0; padding: 20rpx; border-radius: 18rpx; background: var(--surface-muted); }.space-name { margin-bottom: 5rpx; font-weight: 700; }.stat-number { color: var(--green); font-size: 38rpx; font-weight: 780; }.support-links { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx!important; }.support-links view { padding: 12rpx 18rpx; border-radius: 999rpx; color: var(--muted); background: #e9ece7; font-size: 21rpx; }
.node-page { box-sizing: border-box; display: flex; width: 100%; min-height: 100vh; flex-direction: column; overflow: hidden; padding: 26rpx 28rpx calc(32rpx + env(safe-area-inset-bottom)); background: #f5f5f7; touch-action: none; }.node-toolbar { flex: none; min-height: 56rpx; }.back-overview { color: var(--green); font-weight: 700; }.node-position { color: var(--muted); font-size: 22rpx; }.profile-dot.light { border: 1rpx solid var(--line); }.direction-hint { flex: none; color: var(--muted); font-size: 21rpx; text-align: center; }.direction-hint.top { margin-top: 18rpx; }.direction-hint.bottom { margin-top: 15rpx; }.node-stage-line { margin-top: 18rpx; color: var(--ink-soft); font-size: 25rpx; }.node-stage-line text { margin-right: 12rpx; padding: 6rpx 13rpx; border-radius: 999rpx; color: var(--green); background: var(--green-soft); font-size: 20rpx; }.node-card { display: flex; flex: 1; min-height: 0; flex-direction: column; justify-content: center; margin: 20rpx 0; padding: 34rpx; border: 1rpx solid #e5e5ea; border-radius: 34rpx; background: #fff; box-shadow: none; }.node-module { color: var(--green); font-size: 23rpx; font-weight: 700; letter-spacing: 2rpx; }.node-title { margin-top: 13rpx; font-size: 42rpx; font-weight: 780; line-height: 1.25; }.node-count { margin-top: 24rpx; color: var(--muted); }.node-count text { margin-right: 8rpx; color: var(--green); font-size: 58rpx; font-weight: 800; }.node-summary { margin-top: 18rpx; color: var(--ink-soft); line-height: 1.7; }.scope-note { margin-top: 18rpx; padding: 16rpx; border-radius: 14rpx; color: var(--muted); background: var(--surface-muted); font-size: 21rpx; line-height: 1.55; }.node-action { width: 100%; margin-top: 28rpx; }
