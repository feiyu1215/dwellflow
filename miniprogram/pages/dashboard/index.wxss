/* Journey map: the data remains two-dimensional without rendering as a table. */
.journey-map,.journey-legend { margin-right: 28rpx; margin-left: 28rpx; }
.journey-map { margin-top: 6rpx; }
.journey-row { display: flex; position: relative; min-height: 150rpx; }
.journey-rail { position: relative; width: 52rpx; flex: 0 0 52rpx; }
.journey-station { position: absolute; top: 35rpx; left: 10rpx; z-index: 2; width: 18rpx; height: 18rpx; border: 4rpx solid #d1d1d6; border-radius: 50%; background: #f5f5f7; }
.journey-line { position: absolute; top: 57rpx; bottom: -35rpx; left: 20rpx; width: 3rpx; background: #e5e5ea; }
.journey-row.past .journey-station { border-color: #8e8e93; background: #8e8e93; }
.journey-row.current .journey-station { top: 39rpx; left: 7rpx; width: 24rpx; height: 24rpx; border-color: #0071e3; background: #fff; box-shadow: 0 0 0 8rpx #e8f2ff; }
.journey-row.current .journey-line { top: 67rpx; }
.journey-content { box-sizing: border-box; width: calc(100% - 52rpx); min-width: 0; padding: 22rpx 0 28rpx; border-bottom: 1rpx solid #e5e5ea; }
.journey-row.current .journey-content { margin: 0 0 22rpx; padding: 28rpx 24rpx 25rpx; border: 1rpx solid #d6e8fb; border-radius: 28rpx; background: #fff; box-shadow: 0 7rpx 26rpx rgba(0,113,227,.06); }
.journey-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.journey-stage { color: #3a3a3c; font-size: 28rpx; font-weight: 650; }.journey-row.current .journey-stage { color: #1d1d1f; font-size: 34rpx; font-weight: 700; }
.journey-state { margin-top: 3rpx; color: #8e8e93; font-size: 19rpx; }.current-badge { flex: none; padding: 7rpx 13rpx; border-radius: 999rpx; color: #0071e3; background: #e8f2ff; font-size: 18rpx; font-weight: 600; }
.node-scroll { width: 100%; margin-top: 19rpx; white-space: nowrap; }.node-strip { display: inline-flex; gap: 14rpx; padding-right: 8rpx; }
