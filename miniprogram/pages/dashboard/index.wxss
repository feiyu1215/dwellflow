.journey-legend { margin-top: 12rpx; color: #8e8e93; font-size: 20rpx; text-align: center; }.journey-legend .legend-dot { margin-left: 18rpx; }

/* R8-1D project gateway */
.scene-gateway { min-height: 100vh; box-sizing: border-box; padding-top: 42rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: #f5f5f7; }
