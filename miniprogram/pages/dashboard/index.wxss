}
.r7-project-name {
  margin-top: 26rpx;
  color: #1d1f1e;
  font-size: 60rpx;
  font-weight: 750;
  line-height: 1.08;
  letter-spacing: -3rpx;
}
.r7-now-line {
  display: grid;
  grid-template-columns: 16rpx minmax(0,1fr);
