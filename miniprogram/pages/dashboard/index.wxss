}
.r7-focus-copy { min-width: 0; }
.r7-focus-copy > text {
  display: block;
  overflow: hidden;
  color: #1d1f1e;
  font-size: 24rpx;
  font-weight: 680;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.r7-focus-copy > view { margin-top: 8rpx; color: #6e756f; font-size: 20rpx; line-height: 1.45; }
.r7-overview-empty { padding: 100rpx 48rpx; color: #6e756f; text-align: center; }
.r7-overview-empty > text { display: block; margin-top: 22rpx; color: #1d1f1e; font-size: 30rpx; font-weight: 700; }
.r7-empty-copy { margin-top: 10rpx; font-size: 20rpx; }
.r7-overview-empty button { width: 320rpx; margin-top: 28rpx; }
.r7-empty-plan {
  display: grid;
  width: 150rpx;
  height: 132rpx;
  grid-template-columns: 1fr 1.35fr;
  grid-template-rows: 1fr 1fr;
  gap: 8rpx;
  margin: 0 auto;
  transform: rotate(-5deg);
}
.r7-empty-plan view { border: 3rpx solid #9ba59e; }
.r7-empty-plan view:last-child { grid-column: 1 / 3; }
.r7-bottom-safe {
  position: fixed;
  z-index: 24;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  min-height: 148rpx;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  padding: 20rpx 36rpx calc(38rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(217,222,218,.86);
