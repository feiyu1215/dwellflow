.flow-marker { position: relative; z-index: 1; width: 12rpx; height: 12rpx; margin-top: 11rpx; margin-left: -22rpx; border: 3rpx solid #fff; border-radius: 50%; background: #aeb5b0; box-shadow: 0 0 0 2rpx #aeb5b0; }
.flow-moment.current .flow-marker { background: var(--blue); box-shadow: 0 0 0 3rpx var(--blue-soft); }
.moment-label { color: var(--faint); font-size: 18rpx; font-weight: 650; }
.moment-stage { margin-top: 2rpx; color: var(--ink); font-size: 26rpx; font-weight: 700; }
.moment-summary { margin-top: 4rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.continue-patrol { width: 100%; margin-top: 4rpx; }

.resources-section { margin-right: 0; margin-left: 0; padding: 42rpx 36rpx 36rpx; background: var(--canvas); }
.resource-list { margin-top: 20rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 26rpx; background: #fff; }
.resource-row { display: flex; min-height: 110rpx; align-items: center; gap: 17rpx; margin-left: 22rpx; padding: 16rpx 22rpx 16rpx 0; border-bottom: 1rpx solid #ecefed; }
.resource-row:last-child { border-bottom: 0; }
.resource-glyph { display: grid; width: 50rpx; height: 50rpx; flex: none; place-items: center; border-radius: 14rpx; background: var(--canvas); }
.resource-glyph view { box-sizing: border-box; width: 22rpx; height: 27rpx; border: 2rpx solid #7c8580; border-radius: 3rpx; }
.resource-copy { min-width: 0; flex: 1; }
.resource-label { color: var(--ink); font-size: 24rpx; font-weight: 680; }
.resource-description { margin-top: 4rpx; overflow: hidden; color: var(--muted); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.resource-tail { display: flex; flex: none; align-items: center; gap: 10rpx; }
.resource-count { max-width: 132rpx; overflow: hidden; color: var(--muted); font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }
.resource-arrow { color: #afb5b1; font-size: 36rpx; font-weight: 300; }
.ai-entry { display: grid; grid-template-columns: 56rpx minmax(0,1fr) auto; align-items: center; gap: 17rpx; margin: 24rpx 36rpx 0; padding: 22rpx; border: 1rpx solid #bfd8fb; border-radius: 24rpx; background: #f7fbff; }
.ai-glyph { width: 56rpx; height: 56rpx; border-radius: 16rpx; color: #fff; background: var(--blue); font-size: 18rpx; font-weight: 760; line-height: 56rpx; text-align: center; }
.ai-entry-main { min-width: 0; }
.ai-entry-label { color: var(--ink); font-size: 24rpx; font-weight: 700; }
.ai-entry-copy { margin-top: 4rpx; color: var(--muted); font-size: 19rpx; line-height: 1.45; }

.patrol-page { box-sizing: border-box; min-height: 100vh; padding: 0 0 calc(30rpx + env(safe-area-inset-bottom)); background: #eef1ee; }
.patrol-location-bar { position: relative; z-index: 12; display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 14rpx; min-height: 116rpx; padding: 18rpx 28rpx; border-bottom: 1rpx solid rgba(217,222,218,.9); background: rgba(255,255,255,.96); }
.patrol-location-copy { min-width: 0; }
.patrol-location-copy view { overflow: hidden; color: var(--ink); font-size: 28rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.patrol-location-copy text { display: block; margin-top: 3rpx; overflow: hidden; color: var(--muted); font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.patrol-axis-readout { display: flex; gap: 10rpx; }
.patrol-axis-readout view { display: grid; min-height: 68rpx; place-items: center; padding: 0 16rpx; border: 1rpx solid var(--line); border-radius: 20rpx; color: var(--ink); background: #fff; font-size: 17rpx; white-space: nowrap; }
.patrol-axis-readout view.active { color: #075acb; border-color: #b5d2fb; background: var(--blue-soft); }
.patrol-canvas { position: relative; height: calc(100vh - 500rpx); min-height: 650rpx; max-height: 940rpx; overflow: hidden; border-radius: 0; background: #dfe4e0; touch-action: none; }
.patrol-image { width: 100%; height: 100%; }
.patrol-canvas::after { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg,rgba(8,12,10,.07),transparent 45%,rgba(8,12,10,.74)); content: ""; }
.canvas-coordinate { position: absolute; z-index: 5; top: 18rpx; left: 50%; padding: 9rpx 14rpx; transform: translateX(-50%); border: 1rpx solid rgba(255,255,255,.55); border-radius: 999rpx; color: #fff; background: rgba(13,17,15,.5); font-size: 17rpx; white-space: nowrap; }
.stage-rail { position: absolute; z-index: 6; top: 110rpx; left: 22rpx; display: flex; flex-direction: column; gap: 12rpx; }
.stage-stop { display: grid; box-sizing: border-box; width: 72rpx; min-height: 72rpx; place-items: center; padding: 0; border: 1rpx solid rgba(255,255,255,.58); border-radius: 24rpx; color: #fff; background: rgba(15,19,17,.42); font-size: 18rpx; font-weight: 680; }
.stage-stop.selected { color: #075acb; border-color: #fff; background: #fff; }
.stage-stop.project-current { box-shadow: inset 0 0 0 2rpx rgba(116,178,255,.32); }
.patrol-empty,.evidence-unavailable { position: relative; z-index: 1; display: flex; box-sizing: border-box; height: 100%; flex-direction: column; align-items: center; justify-content: center; padding: 80rpx 60rpx; text-align: center; }
.patrol-empty { background-color: #f8f9f7; background-image: linear-gradient(#e7ebe8 1rpx,transparent 1rpx),linear-gradient(90deg,#e7ebe8 1rpx,transparent 1rpx); background-size: 38rpx 38rpx; }
.patrol-empty .empty-title,.evidence-unavailable .empty-title { margin-top: 26rpx; font-size: 30rpx; }
.patrol-empty .empty-copy,.evidence-unavailable .empty-copy { max-width: 440rpx; margin-top: 10rpx; color: var(--muted); font-size: 20rpx; line-height: 1.55; }
.empty-action { position: relative; z-index: 7; min-width: 270rpx; margin-top: 28rpx; }
.empty-plan { position: relative; width: 260rpx; height: 210rpx; transform: rotate(-5deg); }
.empty-plan view { position: absolute; border: 3rpx solid #9ba59e; }
.plan-a { top: 8rpx; left: 12rpx; width: 120rpx; height: 88rpx; }
.plan-b { top: 8rpx; right: 8rpx; width: 105rpx; height: 132rpx; }
.plan-c { bottom: 5rpx; left: 12rpx; width: 148rpx; height: 90rpx; }
.empty-plan .plan-route { top: 90rpx; left: 126rpx; width: 42rpx; height: 38rpx; border-top: 0; border-right: 0; border-bottom-style: dashed; border-left-style: dashed; }
.empty-mark { width: 64rpx; height: 64rpx; border: 3rpx solid var(--muted); border-radius: 50%; color: var(--muted); font-size: 34rpx; line-height: 64rpx; }
.evidence-pin { position: absolute; z-index: 8; top: 32%; left: 64%; display: grid; box-sizing: border-box; width: 84rpx; height: 84rpx; place-items: center; border: 4rpx solid #fff; border-radius: 50%; color: #fff; background: #b87500; box-shadow: 0 12rpx 40rpx rgba(30,28,18,.26); font-size: 24rpx; font-weight: 760; }
.evidence-pin::after { position: absolute; top: 76rpx; left: 32rpx; border: 10rpx solid transparent; border-top-color: #fff; content: ""; }
.evidence-caption { position: absolute; z-index: 4; right: 32rpx; bottom: 32rpx; left: 32rpx; padding-left: 4rpx; color: #fff; }
.caption-meta { color: rgba(255,255,255,.72); font-size: 18rpx; }
.caption-title { margin-top: 8rpx; overflow: hidden; font-size: 36rpx; font-weight: 740; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.caption-copy { margin-top: 8rpx; color: rgba(255,255,255,.78); font-size: 19rpx; }
.patrol-controls { padding: 0 24rpx; background: #fff; }
.evidence-filmstrip,.space-filmstrip { margin-top: 0; white-space: nowrap; }
.evidence-filmstrip { padding-top: 14rpx; }
.evidence-chip { display: inline-block; max-width: 300rpx; margin-right: 10rpx; padding: 10rpx 15rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 12rpx; color: var(--muted); background: #fff; font-size: 18rpx; text-overflow: ellipsis; vertical-align: top; }
.evidence-chip.active { border-color: var(--blue); color: #075acb; background: var(--blue-soft); }
.space-track { display: inline-flex; gap: 16rpx; padding: 18rpx 0 14rpx; }
.space-track-item { box-sizing: border-box; min-width: 152rpx; min-height: 112rpx; padding: 16rpx 20rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: #fff; }
.space-track-item view { font-size: 21rpx; font-weight: 680; }
.space-track-item text { display: block; margin-top: 3rpx; color: var(--muted); font-size: 16rpx; }
.space-track-item.active { border-color: #b7d3fa; background: var(--blue-soft); }
.space-track-item.active view { color: #075acb; }
.patrol-footer { display: grid; grid-template-columns: 1fr 1.6fr; gap: 12rpx; margin-top: 11rpx; }
.patrol-footer button { width: 100%; margin: 0; }
.gesture-help { padding: 15rpx 4rpx 0; color: var(--faint); font-size: 17rpx; line-height: 1.4; text-align: center; }
.enter-left { animation: uiEnterRight .27s cubic-bezier(.22,1,.36,1); }
.enter-right { animation: uiEnterLeft .27s cubic-bezier(.22,1,.36,1); }
.enter-up { animation: uiEnterBottom .27s cubic-bezier(.22,1,.36,1); }
.enter-down { animation: uiEnterTop .27s cubic-bezier(.22,1,.36,1); }
@keyframes uiEnterRight { from { opacity:.35; transform:translateX(40rpx); } }
@keyframes uiEnterLeft { from { opacity:.35; transform:translateX(-40rpx); } }
@keyframes uiEnterBottom { from { opacity:.35; transform:translateY(40rpx); } }
@keyframes uiEnterTop { from { opacity:.35; transform:translateY(-40rpx); } }

@media (max-width: 360px) {
  .overview-page .project-name { font-size: 49rpx; }
  .focus-card { grid-template-columns: auto minmax(0,1fr); }
  .focus-action { grid-column: 2; }
  .topology-grid { grid-auto-rows: 92rpx; min-height: 390rpx; padding: 22rpx 18rpx; }
  .topology-node { padding: 13rpx; }
  .topology-node .space-name { font-size: 22rpx; }
  .space-state { display: none; }
  .resource-count { display: none; }
  .patrol-canvas { min-height: 600rpx; }
  .stage-stop { width: 66rpx; min-height: 53rpx; }
  .caption-title { font-size: 31rpx; }
}

/* R8-UI-2A: project objects are grouped as four purpose-led drawers. */
.resources-section { overflow: hidden; }
.resource-drawer { width: 100%; margin-top: 20rpx; white-space: nowrap; }
.resource-cluster-track { display: inline-flex; gap: 16rpx; padding: 2rpx 36rpx 12rpx 0; }
.resource-cluster { box-sizing: border-box; width: 470rpx; min-height: 390rpx; padding: 27rpx 26rpx 20rpx; border: 1rpx solid var(--line); border-radius: 28rpx; background: #fff; vertical-align: top; white-space: normal; }
.resource-cluster.cluster-site { border-top: 5rpx solid #0a73dc; }
.resource-cluster.cluster-delivery { border-top: 5rpx solid #353d38; }
.resource-cluster.cluster-collaboration { border-top: 5rpx solid #88a79a; }
.resource-cluster.cluster-tools { border-top: 5rpx solid #b8beb9; }
.cluster-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.cluster-order { color: var(--blue); font-size: 15rpx; font-weight: 760; letter-spacing: 2rpx; }
.cluster-label { margin-top: 3rpx; color: var(--ink); font-size: 31rpx; font-weight: 760; }
.cluster-count { padding: 7rpx 12rpx; border-radius: 999rpx; color: var(--muted); background: var(--canvas); font-size: 16rpx; }
.cluster-summary { margin-top: 8rpx; color: var(--muted); font-size: 18rpx; line-height: 1.45; }
.cluster-entry { display: flex; min-height: 68rpx; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 10rpx; padding: 0 2rpx; border-top: 1rpx solid #ecefed; }
.cluster-entry:first-of-type { margin-top: 17rpx; }
.cluster-entry-main { display: flex; min-width: 0; flex: 1; align-items: baseline; justify-content: space-between; gap: 13rpx; }
.cluster-entry-label { overflow: hidden; color: var(--ink); font-size: 21rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
.cluster-entry-count { flex: none; color: var(--muted); font-size: 16rpx; }
.cluster-entry .resource-arrow { font-size: 30rpx; }
.cluster-foot { margin-top: 12rpx; color: var(--faint); font-size: 15rpx; text-align: right; }


/* R8-UI-3: the production overview now follows the frozen R7 overview frame exactly. */
.r7-overview-page {
  position: relative;
  box-sizing: border-box;
  height: 100vh;
  overflow: hidden;
  background: #fff;
}
.r7-overview-scroll {
  box-sizing: border-box;
  height: 100%;
  padding-bottom: calc(188rpx + env(safe-area-inset-bottom));
  background: #fff;
}
.r7-overview-intro { padding: 42rpx 36rpx 28rpx; }
.r7-overview-topline { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.r7-phase-pill {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  color: #075acb;
  background: #eaf2ff;
  font-size: 20rpx;
