  line-height: 92rpx;
}
.r7-bottom-safe .primary { min-width: 0; flex: 1; background: #0a6cff; }
.r7-bottom-safe .secondary { min-width: 184rpx; flex: 0 0 auto; }

@media (max-width: 360px) {
  .r7-project-name { font-size: 54rpx; }
