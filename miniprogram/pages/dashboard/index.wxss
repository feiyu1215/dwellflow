}
.r7-archived-banner {
  margin: 0 36rpx 22rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  color: #73572d;
  background: #fff4e5;
  font-size: 20rpx;
  line-height: 1.5;
}
.r7-topology-wrap { padding: 0 24rpx; }
.r7-topology {
  position: relative;
  height: 704rpx;
  overflow: hidden;
  border: 2rpx solid #e1e5e2;
  border-radius: 56rpx;
