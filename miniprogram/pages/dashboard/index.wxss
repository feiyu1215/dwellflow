.node-orb { display: flex; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; border: 2rpx solid #d1d1d6; border-radius: 50%; color: #aeaeb2; background: #fff; font-size: 22rpx; font-weight: 650; }
.node-label { width: 88rpx; margin-top: 9rpx; overflow: hidden; color: #8e8e93; font-size: 18rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
