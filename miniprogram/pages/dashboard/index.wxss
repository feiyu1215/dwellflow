}
.r7-edge.unknown { border-top-style: dotted; opacity: .38; }
.edge-a { top: 29%; left: 41%; width: 13%; }
.edge-b { top: 44%; left: 68%; width: 23%; transform: rotate(88deg); }
.edge-c { top: 42%; left: 34%; width: 25%; transform: rotate(118deg); }
.edge-d { top: 75%; left: 45%; width: 18%; transform: rotate(-8deg); }
.r7-topology-overflow {
  margin: 12rpx 16rpx 0;
  color: #8a918c;
  font-size: 18rpx;
  text-align: right;
}
.r7-focus-sheet {
  margin: 24rpx 36rpx 0;
  padding: 30rpx 0 4rpx;
  border-top: 2rpx solid #e1e5e2;
}
.r7-focus-title { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.r7-focus-title text { color: #1d1f1e; font-size: 32rpx; font-weight: 720; }
.r7-focus-title view { color: #6e756f; font-size: 20rpx; }
.r7-focus-fact { display: grid; grid-template-columns: 100rpx minmax(0,1fr); gap: 20rpx; margin-top: 24rpx; }
.r7-focus-thumb {
  width: 100rpx;
  height: 100rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #edf0ed;
}
.r7-focus-thumb.line-art {
  display: grid;
  box-sizing: border-box;
  place-items: center;
