.matrix-intro { margin-top: 34rpx; margin-bottom: 18rpx; }.matrix-intro .section-title { margin: 0; }.axis-copy { margin-top: 5rpx; color: var(--muted); font-size: 23rpx; }.axis-button { flex: none; min-height: 62rpx; margin: 0; padding: 0 22rpx; border-radius: 999rpx; color: var(--green); background: var(--green-soft); font-size: 23rpx; line-height: 62rpx; }
.matrix-scroll { box-sizing: border-box; width: 100%; padding-left: 28rpx; }.matrix-board { width: 1220rpx; padding-right: 28rpx; }.matrix-header-row,.matrix-row { display: flex; gap: 10rpx; margin-bottom: 10rpx; }.matrix-corner,.matrix-row-label { box-sizing: border-box; position: sticky; left: 0; z-index: 2; width: 142rpx; flex: 0 0 142rpx; border-radius: 17rpx; padding: 15rpx; background: #e9ece7; font-size: 22rpx; font-weight: 700; }.matrix-corner { display: flex; flex-direction: column; justify-content: center; min-height: 88rpx; color: var(--green); }.matrix-corner text { display: block; margin-top: 4rpx; color: var(--muted); font-size: 18rpx; font-weight: 500; }.matrix-column,.matrix-cell { box-sizing: border-box; width: 142rpx; flex: 0 0 142rpx; border-radius: 17rpx; }.matrix-column { display: flex; min-height: 88rpx; align-items: center; justify-content: center; padding: 12rpx; color: var(--ink-soft); background: #edf0eb; font-size: 22rpx; font-weight: 700; text-align: center; }.matrix-row-label { display: flex; min-height: 138rpx; align-items: center; }.matrix-row-label.current { color: #fff; background: var(--green); }.matrix-cell { min-height: 138rpx; padding: 15rpx; border: 1rpx solid var(--line); background: #fff; }.matrix-cell.past { background: #f1f3ef; }.matrix-cell.current { border-color: #77ac9d; background: #e5f1ed; box-shadow: inset 0 0 0 2rpx rgba(23,107,91,.08); }.matrix-cell.upcoming { opacity: .72; }.cell-count { color: var(--green); font-size: 31rpx; font-weight: 780; }.cell-label { margin-top: 7rpx; font-size: 22rpx; font-weight: 700; }.cell-status { margin-top: 4rpx; color: var(--muted); font-size: 19rpx; }
