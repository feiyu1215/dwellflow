@media (max-width: 360px) { .scene-bubble { flex-basis: 260rpx; }.node-card { padding: 27rpx; }.node-title { font-size: 36rpx; }.space-grid,.stat-grid { grid-template-columns: 1fr 1fr; } }

/* iOS Setup-inspired visual system: quiet surfaces, one blue accent, clear hierarchy. */
.matrix-page { background: #f5f5f7; }
