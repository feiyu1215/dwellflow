.scene-gateway .scene-field.list { display: grid; grid-template-columns: 1fr; }
.scene-gateway .scene-bubble { position: relative; min-width: 0; min-height: 250rpx; flex-basis: auto; justify-content: flex-start; padding: 27rpx; border: 1rpx solid #e5e5ea; border-radius: 30rpx; background: #fff; overflow: hidden; }
