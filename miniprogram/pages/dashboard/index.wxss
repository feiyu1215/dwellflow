}
.r7-topology-caption > view {
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #aeb7b1;
  border-radius: 4rpx;
}
.r7-topology-canvas { position: absolute; inset: 70rpx 20rpx 32rpx; }
.r7-room-node {
  position: absolute;
  z-index: 3;
