.backup-notice { margin-bottom: 24rpx; padding: 18rpx 22rpx; border: 1rpx solid #ead59f; border-radius: 18rpx; color: #6d5424; background: #fff9e9; font-size: 22rpx; line-height: 1.55; }
.summary-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }.summary-card { padding: 22rpx 10rpx; border: 1rpx solid var(--line); border-radius: 22rpx; background: #fff; color: var(--muted); font-size: 20rpx; text-align: center; }.summary-card text { display: block; margin-bottom: 3rpx; color: var(--ink); font-size: 38rpx; font-weight: 720; }.summary-card.has-warning text { color: var(--danger); }
.import-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin: 22rpx 0 30rpx; }.import-actions button { margin: 0; }
.evidence-card,.legacy-card { padding: 25rpx; }.evidence-copy { min-width: 0; flex: 1; }.evidence-name { overflow: hidden; color: var(--ink); font-size: 28rpx; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }.status-pill { flex: 0 0 auto; padding: 7rpx 13rpx; border-radius: 999rpx; background: var(--surface-muted); color: var(--muted); font-size: 20rpx; }.status-pill.ready { background: var(--success-soft); color: var(--success); }.status-pill.warning { background: var(--danger-soft); color: var(--danger); }
.hash-line { margin-top: 18rpx; padding: 14rpx 16rpx; border-radius: 14rpx; color: var(--muted); background: var(--surface-muted); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 20rpx; overflow-wrap: anywhere; }.card-actions { display: flex; flex-wrap: wrap; gap: 30rpx; margin-top: 15rpx; }.card-actions .action-link { font-size: 22rpx; }.card-actions .primary-link { font-weight: 680; }.legacy-button { min-height: 70rpx; margin: 20rpx 0 0; font-size: 23rpx; line-height: 70rpx; }.hidden-row { padding: 23rpx; opacity: .78; }
@media (max-width: 360px) { .summary-grid { grid-template-columns: 1fr; }.import-actions { grid-template-columns: 1fr; } }

/* R8-UI-1B evidence library. */
.evidence-page { padding-top: 0; background: #f4f5f3; }
.evidence-topbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 82rpx; padding-top: env(safe-area-inset-top); }
.back-link { min-height: 64rpx; color: #0a73dc; font-size: 24rpx; line-height: 64rpx; }.topbar-title { color: #252a27; font-size: 23rpx; font-weight: 680; }.topbar-space { min-width: 80rpx; }
.evidence-heading { padding: 34rpx 4rpx 26rpx; }.evidence-heading .eyebrow { color: #737a75; font-size: 19rpx; font-weight: 640; letter-spacing: .08em; }.evidence-heading .title { margin-top: 10rpx; color: #171918; font-size: 54rpx; font-weight: 730; line-height: 1.18; }.evidence-heading .subtitle { max-width: 610rpx; margin-top: 15rpx; color: #69706b; font-size: 22rpx; line-height: 1.62; }
.backup-notice { display: flex; align-items: flex-start; gap: 14rpx; margin: 0 0 22rpx; padding: 18rpx 20rpx; border-color: #d9deda; border-radius: 20rpx; color: #626963; background: #f8f9f7; }.notice-mark { display: grid; width: 34rpx; height: 34rpx; flex: 0 0 auto; place-items: center; border: 2rpx solid #89918b; border-radius: 50%; font-family: Georgia,serif; font-size: 21rpx; }
.evidence-summary { display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; border: 1rpx solid #dce1dd; border-radius: 22rpx; background: #fff; }.evidence-summary > view { display: flex; min-height: 96rpx; flex-direction: column; align-items: center; justify-content: center; border-right: 1rpx solid #e5e9e6; }.evidence-summary > view:last-child { border-right: 0; }.evidence-summary text:first-child { color: #171918; font-size: 31rpx; font-weight: 720; }.evidence-summary text:last-child { margin-top: 3rpx; color: #737a75; font-size: 18rpx; }.evidence-summary .has-warning text:first-child { color: #c34b3d; }
.import-actions { margin: 18rpx 0 38rpx; }.import-actions button { min-height: 80rpx; border-radius: 20rpx; line-height: 80rpx; }
.section-head { margin: 38rpx 2rpx 15rpx; }.section-title { font-size: 29rpx; font-weight: 700; }.section-kicker { margin-top: 5rpx; color: #777e79; font-size: 20rpx; }
.evidence-card { display: grid; grid-template-columns: 72rpx minmax(0,1fr) auto; align-items: center; gap: 18rpx; margin-bottom: 12rpx; padding: 20rpx; border: 1rpx solid #dde2de; border-radius: 24rpx; background: #fff; box-shadow: none; }
.evidence-glyph { position: relative; display: grid; width: 72rpx; height: 72rpx; place-items: center; border-radius: 18rpx; background: #eef4ff; }.evidence-glyph view { width: 31rpx; height: 35rpx; border: 3rpx solid #0a84ff; border-radius: 5rpx; }.evidence-glyph.image view::after { display: block; width: 10rpx; height: 10rpx; margin: 7rpx; border: 2rpx solid #0a84ff; border-radius: 50%; content: ""; }.evidence-glyph.audio view { width: 17rpx; border-radius: 999rpx; }.evidence-glyph.video view { width: 34rpx; height: 26rpx; }.evidence-glyph.document { background: #f1f2f0; }.evidence-glyph.document view { border-color: #68706a; }
.evidence-name { font-size: 25rpx; }.evidence-copy .meta { margin-top: 6rpx; color: #737a75; font-size: 19rpx; }.evidence-foot { margin-top: 8rpx; overflow: hidden; color: #929893; font-family: ui-monospace,SFMono-Regular,Menlo,monospace; font-size: 17rpx; text-overflow: ellipsis; white-space: nowrap; }
.evidence-tail { align-self: stretch; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }.status-pill { font-size: 18rpx; }.row-arrow { color: #9ba19d; font-size: 34rpx; }
.card-actions { grid-column: 2 / 4; gap: 25rpx; margin-top: 0; padding-top: 15rpx; border-top: 1rpx solid #edf0ee; }.card-actions .action-link { min-height: 44rpx; color: #5e6660; font-size: 20rpx; line-height: 44rpx; }
.legacy-card,.hidden-row,.empty { border: 1rpx solid #dde2de; border-radius: 24rpx; background: #fff; box-shadow: none; }
@media (max-width: 360px) { .evidence-heading .title { font-size: 46rpx; }.evidence-card { grid-template-columns: 62rpx minmax(0,1fr); }.evidence-glyph { width: 62rpx; height: 62rpx; }.evidence-tail { grid-column: 1 / 3; flex-direction: row; align-items: center; }.card-actions { grid-column: 1 / 3; }.evidence-summary { grid-template-columns: repeat(3,1fr); } }
