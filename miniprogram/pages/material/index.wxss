  .task-link { grid-column: 2; }
  .comparison-summary { grid-template-columns: 1fr; }
  .value-pair { grid-template-columns: 1fr; }
  .value-arrow { transform: rotate(90deg); }
  .object-section-head { display: block; }
  .object-section-head .section-kicker { max-width: none; margin-top: 5rpx; text-align: left; }
  .focus-actions.object-action-dock { margin-right: -22rpx; margin-left: -22rpx; padding-right: 22rpx; padding-left: 22rpx; }
}

.origin-context { display: inline-flex; align-items: center; gap: 10rpx; max-width: 100%; margin-top: 16rpx; padding: 10rpx 14rpx; border: 1rpx solid #cfe1fa; border-radius: 999rpx; color: #1767c5; background: #f1f7ff; font-size: 20rpx; line-height: 1.4; }
.origin-context > view { flex: none; width: 9rpx; height: 9rpx; border-radius: 50%; background: #1476ec; }
.origin-context text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
