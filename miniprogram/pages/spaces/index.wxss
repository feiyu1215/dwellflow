.compact-button { min-height: 66rpx; margin: 0; padding: 0 25rpx; font-size: 23rpx; line-height: 66rpx; }
.backup-notice { margin-bottom: 20rpx; padding: 18rpx 22rpx; border: 1rpx solid #ead59f; border-radius: 18rpx; color: #6d5424; background: #fff9e9; font-size: 22rpx; line-height: 1.55; }
.space-list { display: grid; gap: 16rpx; }.space-card { margin: 0; }.space-main { min-width: 0; flex: 1; }.space-name { color: var(--ink); font-size: 29rpx; font-weight: 700; overflow-wrap: anywhere; }
.space-facts { display: flex; flex-wrap: wrap; gap: 10rpx 22rpx; margin-top: 20rpx; color: var(--muted); font-size: 21rpx; }.space-actions { display: flex; flex-wrap: wrap; gap: 4rpx 25rpx; margin-top: 20rpx; padding-top: 14rpx; border-top: 1rpx solid var(--line); }.space-actions .action-link { font-size: 22rpx; }.danger-link { color: var(--danger); }
.compact-empty { padding: 26rpx; color: var(--muted); }.mapping-card { padding: 25rpx; }.mapping-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 20rpx; }.mapping-button { min-height: 72rpx; margin: 0; padding: 0 16rpx; font-size: 22rpx; line-height: 72rpx; }.mapping-picker { min-height: 72rpx; margin: 0; padding: 17rpx 12rpx; color: var(--green); font-size: 22rpx; text-align: center; }
.single-action { grid-template-columns: 1fr; }.single-action .mapping-button { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.relation-row,.inactive-row { padding: 24rpx; margin-bottom: 14rpx; }.relation-source { margin: -8rpx 0 24rpx; }.switch-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin: 24rpx 0; padding: 22rpx; border-radius: 20rpx; background: var(--surface-muted); }.switch-title { font-weight: 650; }.section-link { margin: 32rpx 0 0; color: var(--green); font-weight: 650; text-align: center; }
@media (max-width: 360px) { .mapping-actions { grid-template-columns: 1fr; } }
