.project-card { border-left: 8rpx solid transparent; }
.project-card.selected { border-left-color: var(--green); }
.project-card.archived { background: #f5f5f7; }
.project-card.trashed { background: #f6efea; border-color: #ead7ca; }
.project-main { min-width: 0; flex: 1; }
.item-title { font-weight: 680; margin-bottom: 8rpx; }
.project-status { display: flex; align-items: flex-end; flex-direction: column; gap: 8rpx; }
.project-links { display: flex; gap: 28rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.danger-link { color: #9b4537; }
.group-title { margin-top: 38rpx; }
.hint { color: var(--muted); font-size: 24rpx; line-height: 1.6; margin: -12rpx 0 18rpx; }
.lifecycle-text { color: var(--muted); font-size: 23rpx; margin-top: 10rpx; line-height: 1.5; }
.project-head { margin-top: 4rpx; }
.create-button { min-height: 64rpx; margin: 0; padding: 0 24rpx; font-size: 24rpx; line-height: 64rpx; }
.project-empty { padding: 36rpx 24rpx; border: 1rpx dashed #d1d1d6; border-radius: 22rpx; background: #fff; }
.tools-head { margin-top: 44rpx; }
.collaboration-entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.featured-entry { border-color: #d6e8fb; background: #f5f9ff; }
.entry-title { margin-bottom: 8rpx; font-weight: 700; }
.entry-arrow { color: var(--green); font-size: 54rpx; }
.workspace-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.compact-entry { min-height: 190rpx; margin: 0; padding: 22rpx; align-items: flex-end; }
.compact-entry .entry-arrow { font-size: 40rpx; }
.entry-tag { display: inline-block; margin-bottom: 20rpx; border-radius: 999rpx; padding: 6rpx 12rpx; color: var(--green); background: var(--green-soft); font-size: 20rpx; }
.pending-tag { color: var(--amber); background: var(--amber-soft); }
.lifecycle-description { margin-bottom: 18rpx; }
.notice { background: var(--success-soft); color: var(--success); border-radius: 16rpx; padding: 18rpx; font-size: 24rpx; line-height: 1.6; margin-bottom: 24rpx; }
.danger-notice { background: var(--danger-soft); color: var(--danger); }
.danger-button { background: var(--danger); color: #fff; border-radius: 999rpx; margin-top: 28rpx; }
.scene-field { position: relative; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin: 8rpx 0 34rpx; padding: 20rpx 0; border-radius: 32rpx; background: transparent; }
.scene-field::before { display: none; }
.scene-field.single { grid-template-columns: minmax(0, 1fr); place-items: center; }
.scene-bubble { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; height: 250rpx; min-width: 0; box-sizing: border-box; border: 1rpx solid #e5e5ea; border-radius: 28rpx; padding: 26rpx; text-align: left; box-shadow: none; }
.scene-bubble:active { opacity: .78; transform: scale(.98); }
.scene-bubble.selected { border: 3rpx solid #0071e3; box-shadow: 0 8rpx 24rpx rgba(0,113,227,.09); }
.tone-0,.tone-1,.tone-2,.tone-3 { color: #1d1d1f; background: #fff; }
.scene-current { position: absolute; top: 18rpx; right: 18rpx; border-radius: 999rpx; padding: 5rpx 13rpx; color: #0071e3; background: #e8f2ff; font-size: 19rpx; font-weight: 700; }
.scene-name { max-width: 100%; overflow: hidden; font-size: 30rpx; font-weight: 760; text-overflow: ellipsis; white-space: nowrap; }
.scene-stage { margin-top: 7rpx; font-size: 23rpx; opacity: .78; }
.scene-attention { margin-top: 13rpx; font-size: 21rpx; opacity: .82; }
.current-scene-card { margin-bottom: 34rpx; }

@media (max-width: 360px) {
  .scene-field { gap: 12rpx; padding-right: 8rpx; padding-left: 8rpx; }
  .scene-bubble { height: 280rpx; padding: 18rpx; }
  .scene-name { font-size: 27rpx; }
}
