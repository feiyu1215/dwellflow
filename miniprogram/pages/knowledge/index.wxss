.filter-card { display: grid; grid-template-columns: 1fr auto; gap: 12rpx; margin-bottom: 12rpx; }
.search-input, .stage-picker { background: #fff; border: 1rpx solid var(--line); border-radius: 18rpx; padding: 22rpx; }
.stage-picker { color: var(--green); font-weight: 650; min-width: 150rpx; text-align: center; }
.result-count { margin: 18rpx 0; }
.knowledge-card { cursor: pointer; }
.stage-label { color: var(--green); font-size: 24rpx; font-weight: 700; }
.item-title { font-size: 32rpx; font-weight: 750; margin-top: 22rpx; }
.object { margin-top: 10rpx; }
.phenomenon { margin-top: 18rpx; line-height: 1.65; }
.detail-title { font-size: 40rpx; font-weight: 760; line-height: 1.35; margin: 24rpx 0 30rpx; }
.detail-section { margin-bottom: 30rpx; }
.detail-heading { font-weight: 750; margin-bottom: 14rpx; }
.detail-text { line-height: 1.65; flex: 1; }
.number-row { display: flex; gap: 16rpx; margin-bottom: 14rpx; }
.number { width: 42rpx; height: 42rpx; border-radius: 50%; background: var(--green-soft); color: var(--green); text-align: center; line-height: 42rpx; font-size: 22rpx; flex: none; }
.chip-wrap { display: flex; flex-wrap: wrap; gap: 10rpx; }
.evidence-chip { background: #fff; border: 1rpx solid var(--line); border-radius: 999rpx; padding: 10rpx 16rpx; font-size: 24rpx; }
.bullet-row { line-height: 1.7; margin-bottom: 8rpx; }
.source-box { background: #eeece5; border-radius: 18rpx; padding: 22rpx; margin-bottom: 18rpx; }
.source-title { margin: 8rpx 0; line-height: 1.5; }
